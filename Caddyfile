{
    # Disable Caddy's automatic HTTPS — certificate is provided via mkcert
    auto_https off
}

# Plain HTTP redirects to HTTPS, with one exception: liveness probes.
# Container healthchecks, load balancers, and uptime monitors frequently
# cannot follow a 301 or trust a private CA, and /health is unauthenticated
# by design and returns nothing but {"status": "ok"} — so it is served
# directly here rather than bounced to TLS.
:80 {
    handle /health {
        reverse_proxy mnemomatic:8000
    }

    handle {
        redir https://{host}{uri} permanent
    }
}

# HTTPS reverse proxy
:443 {
    tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem

    # A second ceiling on top of the app's own 4 MB limit, so an oversized
    # upload is refused whichever layer notices it first. The :80 block needs
    # none — it only serves /health and redirects.
    request_body {
        max_size 4MB
    }

    # HSTS belongs here, where TLS is terminated. No includeSubDomains and no
    # preload: this is a LAN deployment behind a private CA, and the operator
    # may well serve other things on subdomains of the same host.
    header Strict-Transport-Security "max-age=31536000"

    reverse_proxy mnemomatic:8000
}
